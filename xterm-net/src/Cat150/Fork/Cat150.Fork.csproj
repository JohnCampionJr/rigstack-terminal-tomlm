<Project Sdk="Microsoft.NET.Sdk">

  <!-- The FORK, by project reference. FORK lights up the byte entry, which the released library
       does not have. With the flag off, both projects take the identical string path. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <AssemblyName>Cat150.Fork</AssemblyName>
    <RootNamespace>Cat150</RootNamespace>
    <DefineConstants>$(DefineConstants);FORK</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../../XTerm.NET/XTerm.NET.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="../Harness.cs" Link="Harness.cs" />
    <Compile Include="../Program.cs" Link="Program.cs" />
  </ItemGroup>

</Project>
