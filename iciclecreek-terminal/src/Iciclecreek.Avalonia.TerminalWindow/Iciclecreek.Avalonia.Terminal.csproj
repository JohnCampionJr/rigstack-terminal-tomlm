<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>
  <PropertyGroup>
    <Version>3.2.0</Version>
    <AssemblyVersion>3.2.0.0</AssemblyVersion>
    <Description>Avalonia terminal controls (TerminalControl/TerminalWindow) that provide an XTerm console for hosting console applications in Avalonia, including Sixel and Kitty graphics.</Description>
    <Company>Iciclecreek</Company>
    <Authors>Tom Laird-McConnell</Authors>
    <Keyword>xterm;terminal;avalonia</Keyword>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/tomlm/Iciclecreek.Avalonia.Terminal</PackageProjectUrl>
    <PackageIconUrl>https://raw.githubusercontent.com/tomlm/Iciclecreek.Avalonia.Terminal/master/icon.png</PackageIconUrl>
    <PackageIcon>icon.png</PackageIcon>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <RepositoryUrl>https://github.com/tomlm/Iciclecreek.Avalonia.Terminal</RepositoryUrl>
    <Copyright>Tom Laird-McConnell All Rights Reserved</Copyright>
    <RootNamespace>Iciclecreek.TerminalWindow</RootNamespace>
    <ContentTargetFolders>content</ContentTargetFolders>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <GeneratePackageOnBuild>True</GeneratePackageOnBuild>
  </PropertyGroup>

  <ItemGroup>
    <None Include="../../README.md" Pack="true" PackagePath="" />
    <None Include="../../icon.png" Pack="true" PackagePath="" />
  </ItemGroup>

  <ItemGroup>
    <AvaloniaResource Include="Themes\**" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.0.2" />
    <PackageReference Include="Porta.Pty" Version="2.1.1" />
    <PackageReference Include="Unicode.net" Version="2.0.0" />
    <PackageReference Include="Wcwidth" Version="4.0.1" />
  </ItemGroup>

  <!--
    XTerm.NET comes from a sibling checkout when there is one, and from nuget.org otherwise.

    The point is being able to change the emulator and run this terminal against the change without
    packing anything in between. A condition rather than a plain project reference is what keeps a
    clone building: CI has no sibling checkout, and neither does anyone who only wants the package.

    Set UseLocalXTerm=false to force the published package even with the sibling present, which is
    worth doing before a release to build against exactly what will be restored.
  -->
  <PropertyGroup>
    <LocalXTermProject>$(MSBuildThisFileDirectory)..\..\..\XTerm.NET\src\XTerm.NET\XTerm.NET.csproj</LocalXTermProject>
    <UseLocalXTerm Condition="'$(UseLocalXTerm)' == '' AND Exists('$(LocalXTermProject)')">true</UseLocalXTerm>
    <UseLocalXTerm Condition="'$(UseLocalXTerm)' == ''">false</UseLocalXTerm>
  </PropertyGroup>

  <ItemGroup Condition="'$(UseLocalXTerm)' == 'true'">
    <ProjectReference Include="$(LocalXTermProject)" />
  </ItemGroup>

  <ItemGroup Condition="'$(UseLocalXTerm)' != 'true'">
    <PackageReference Include="XTerm.NET" Version="1.3.0" />
  </ItemGroup>
</Project>
